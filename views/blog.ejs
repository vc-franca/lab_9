<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/styles/global.css">
</head>

<body class="flex flex-col align-center">
    <section class="flex flex-col justify-center align-center gap-10 w-100">
        <h1>POSTS CRIADOS</h1>

        <% for (let i = 0; i < posts.length; i++) { %>
            <div class="bg-green w-20 flex flex-col padding-10">
                <h2><%= posts[i].dbTitulo %></h2>
                <p><%= posts[i].dbResumo %></p>
                <p><%= posts[i].dbConteudo %></p>
            </div>
        <% } %>
    </section>
</body>

</html>